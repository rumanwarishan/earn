APP_NAME="Billions Earn"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://earn.billionsstore.com
APP_KEY=change-me-to-a-random-32-byte-hex-string
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billions_earn
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4

SESSION_NAME=billions_earn_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=change_me@billionsstore.com
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS=no-reply@billionsstore.com
MAIL_FROM_NAME="Billions Earn"

# BTC price provider: "manual" (admin enters rate at approval time) or "coingecko"
BTC_PRICE_PROVIDER=manual
BTC_PRICE_API_KEY=

# Optional AI chatbot layer. Leave blank to use the rule-based chatbot only.
AI_CHATBOT_PROVIDER=
AI_CHATBOT_API_KEY=

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=15
