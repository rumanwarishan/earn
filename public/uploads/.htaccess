# Uploaded files are never executable, even if a filename were ever crafted
# to look like a script - defense in depth on top of FileUploadService's
# MIME/extension whitelist and GD re-encoding.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl)$">
    Require all denied
</FilesMatch>
